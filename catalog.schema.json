{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Arrumo plugin registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "plugins"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository",
          "default"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "repository": {
            "type": "string",
            "pattern": "^https://[^\\s?#]+$"
          },
          "default": {
            "type": "boolean"
          },
          "releases": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "manifestSchemaVersion",
                "packageUrl",
                "sha256"
              ],
              "properties": {
                "version": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
                },
                "manifestSchemaVersion": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295
                },
                "packageUrl": {
                  "type": "string",
                  "pattern": "^https://[^\\s?#]+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
